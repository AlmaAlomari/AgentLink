# One key is enough: each agent role uses a different model.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=YOUR_API_KEY

# Model per role. Uncomment to override the built-in table for your provider.
# planner  = Agent A, turns the request into a structured frame
# analyst  = Agent B, answers using your documents
# verifier = Agent C, judges Agent B's answer against the evidence
# arabic   = Agent B when the request is in Arabic
# LLM_MODEL_PLANNER=openai/gpt-oss-20b
# LLM_MODEL_ANALYST=openai/gpt-oss-120b
# LLM_MODEL_VERIFIER=qwen/qwen3.8-27b
# LLM_MODEL_ARABIC=allam-2-7b

# Token budget per role. Reasoning models spend budget before answering,
# so raise these if you see "used its whole token budget before answering".
# LLM_TOKENS_PLANNER=900
# LLM_TOKENS_ANALYST=1500
# LLM_TOKENS_VERIFIER=800
# LLM_TOKENS_ARABIC=1200

# Max Live AI calls per normal user per day (admin unlimited)
LIVE_LIMIT=20

# Uploaded files (My Data page): PDF, DOCX, TXT, CSV, MD, JSON, LOG
MAX_FILE_BYTES=5000000
MAX_FILES=25

# Session lifetime in hours
SESSION_HOURS=24

# Optional Telegram bot (create it with @BotFather), then remove the leading #:
# TELEGRAM_BOT_TOKEN=123456:ABC-your-token
